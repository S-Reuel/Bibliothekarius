<%= form_with(model: livro) do |form| %>
  <% if livro.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(livro.errors.count, "error") %> prohibited this livro from being saved:</h2>

      <ul>
        <% livro.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :titulo, style: "display: block" %>
    <%= form.text_field :titulo %>
  </div>

  <div>
    <%= form.label :quantidade_total, style: "display: block" %>
    <%= form.number_field :quantidade_total %>
  </div>

  <div>
    <%= form.label :quantidade_disponivel, style: "display: block" %>
    <%= form.number_field :quantidade_disponivel %>
  </div>

  <div>
    <%= form.label :preco, style: "display: block" %>
    <%= form.text_field :preco %>
  </div>

  <div>
    <%= form.label :data_publicacao, style: "display: block" %>
    <%= form.date_field :data_publicacao %>
  </div>

  <div>
    <%= form.label :autor, style: "display: block" %>
    <%= form.text_field :autor %>
  </div>

  <div>
    <%= form.label :resumo, style: "display: block" %>
    <%= form.textarea :resumo %>
  </div>

  <div>
    <%= form.label :nivel_preferencia, style: "display: block" %>
    <%= form.number_field :nivel_preferencia %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
