<div id="<%= dom_id livro %>">
  <p>
    <strong>Titulo:</strong>
    <%= livro.titulo %>
  </p>

  <p>
    <strong>Quantidade total:</strong>
    <%= livro.quantidade_total %>
  </p>

  <p>
    <strong>Quantidade disponivel:</strong>
    <%= livro.quantidade_disponivel %>
  </p>

  <p>
    <strong>Preco:</strong>
    <%= livro.preco %>
  </p>

  <p>
    <strong>Data publicacao:</strong>
    <%= livro.data_publicacao %>
  </p>

  <p>
    <strong>Autor:</strong>
    <%= livro.autor %>
  </p>

  <p>
    <strong>Resumo:</strong>
    <%= livro.resumo %>
  </p>

  <p>
    <strong>Nivel preferencia:</strong>
    <%= livro.nivel_preferencia %>
  </p>

</div>
